# Larger binary files are kept with Git LFS, not regular Git blobs.
# GitHub rejects regular Git files exceeding 100 MiB.
*.exe filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.asar filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.pak filter=lfs diff=lfs merge=lfs -text
*.pdb filter=lfs diff=lfs merge=lfs -text

# Preserve exact byte sequences (LF/CRLF/mixed-EOL) for SHA-256 sealed QA receipts and fixtures.
docs/qa/*.json -text
docs/qa/**/*.json -text
test/fixtures/*.json -text
