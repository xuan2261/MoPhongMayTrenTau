      ctx.fillText(formatFcvDepth(start,units,0),x0+w-45,y0+62);
      ctx.fillText(formatFcvDepth(start+frame.rangeM/2,units,0),x0+w-48,y0+h/2);
      ctx.fillText(formatFcvDepth(start+frame.rangeM,units,0),x0+w-48,y0+h-12);
