    .lcd-overlay[data-layout="main-menu"] { width: 96%; left: 2%; top: 7%; max-height: 90%; min-width: 0; }
    .lcd-overlay[data-layout="main-menu"] .lcd-overlay-content { padding: 6px; }
    .lcd-overlay[data-layout="main-menu"] .lcd-overlay-footer { white-space: pre-line; overflow-wrap: anywhere; font-size: 9px; line-height: 1.4; padding: 5px 7px; }
    .lcd-overlay[data-layout="func-setting"] .lcd-overlay-footer { white-space: pre-line; overflow-wrap: anywhere; line-height: 1.4; padding: 6px 8px; }
    .lcd-menu-options { flex: 0 1 auto; max-height: 130px; overflow-y: auto; border-top: 2px solid #50647e; background: #f7f8fa; padding: 5px 8px; font-size: 11px; }
    .lcd-menu-options > div { padding: 2px 4px; }
    .lcd-options-title { font-weight: 700; border-bottom: 1px solid #aebac7; }
    .lcd-menu-categories[hidden], .lcd-menu-options[hidden] { display: none; }
    .lcd-overlay .lcd-menu-row[aria-disabled="true"][aria-current="true"] {
      background: #d1d8dc; color: #596673; box-shadow: inset 3px 0 0 #8d9ba4;
      opacity: .9;
    }
    /* Source-grade flags stay in inert DOM metadata and in the instructor UI.
       An invented dashed mark on the operator LCD would imply OEM pixels. */
    /* Original classroom configuration surface. Only the selected row scrolls;
       transaction and key help stay outside the field/choice scrollports. */
    .lcd-overlay[data-layout="configuration"] { width: 96%; left: 2%; top: 7%; height: 88%; max-height: 88%; min-width: 0; }
    .lcd-overlay[data-layout="configuration"] .lcd-overlay-title { flex: 0 0 auto; overflow-wrap: anywhere; }
    .lcd-overlay[data-layout="configuration"] .lcd-overlay-content { padding: 6px; flex: 1 1 auto; }
    .lcd-overlay[data-layout="configuration"] .lcd-menu-options { flex: 0 0 auto; max-height: 112px; min-height: 0; }
    .lcd-overlay[data-layout="configuration"] .lcd-overlay-footer { flex: 0 0 auto; display: block; white-space: pre-line; overflow-wrap: anywhere; line-height: 1.4; padding: 5px 7px; }
    .lcd-config-transaction { flex: 0 0 auto; border-top: 1px solid #c8d3dd; background: #e0e5ea; padding: 6px 8px; font-size: 10px; line-height: 1.4; overflow-wrap: anywhere; }
    .lcd-config-transaction > div:last-child { font-weight: 700; }
    .lcd-config-transaction[hidden] { display: none; }
    .lcd-overlay[data-layout="control"] { width: 78%; left: 11%; top: 15%; min-width: 0; max-height: 80%; }
    .lcd-overlay[data-layout="control"] .lcd-overlay-content { padding: 7px 9px; }
    .lcd-overlay[data-layout="control"] .lcd-overlay-title { flex: 0 0 auto; }
    .lcd-overlay[data-layout="control"] .lcd-overlay-footer { flex: 0 0 auto; display: block; white-space: pre-line; overflow-wrap: anywhere; line-height: 1.4; padding: 6px 8px; }
    .lcd-control-summary { flex: 0 0 auto; padding: 7px 9px; border-top: 1px solid #c8d3dd; background: #e0e5ea; font-size: 10px; line-height: 1.5; overflow-wrap: anywhere; }
    .lcd-control-summary > div:last-child { font-weight: 700; }
    .lcd-control-summary[hidden] { display: none; }
    .off-screen { position: absolute; inset: 0; display: grid; place-content: center; gap: 13px; text-align: center; background: radial-gradient(circle, #132633, #060d13 72%); }
    .off-screen span { color: #91a5ad; letter-spacing: 4px; font-size: 23px; }
    .off-screen small { color: #748c98; font-size: 11px; }
    .off-screen[hidden] { display: none; }
    .instructor-telemetry { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 5px 13px; padding: 10px 9px; margin: 9px 0; border: 1px solid #355769; border-radius: 6px; background: #091b27; color: #a5d0df; font: 600 10px Consolas, monospace; }
    .operator-guidance { border: 1px solid #476a77; border-left: 3px solid #79b7c8;
      border-radius: 8px; background: #102936; color: #d0e2ed; padding: 12px;
      display: grid; gap: 7px; overflow-wrap: anywhere; }
    .operator-guidance h3 { margin: 0 0 3px; }
    .guidance-current { color: #fff; font-size: 12px; font-weight: 700; line-height: 1.5; white-space: pre-line; }
    .guidance-help { color: #d4e7e8; font-size: 12px; line-height: 1.5; white-space: pre-line; }
    .guidance-source { color: #a8bdc9; font-size: 11px; line-height: 1.5; white-space: pre-line; }
    /* V36: only instructor D15 gets scalable readability tokens. The original
       FCV bezel/LCD text remains completely untouched and unstyled by these rules. */
    .instructor-source-matrix {
      --source-matrix-title: #bce2ed;
      --source-matrix-ink: #dbecf3;
      --source-matrix-detail: #b5d0da;
      --source-matrix-accent: #f4d99c;
      display: grid; gap: .75rem; padding: .875rem;
      border: 1px solid #365b67; border-radius: 8px; background: #102937;
      color: var(--source-matrix-ink); min-width: 0; overflow-wrap: anywhere;
    }
    .training-panel .instructor-source-matrix > h3 {
      margin: 0; font-size: 1rem; line-height: 1.45;
      letter-spacing: .04em;
    }
    .instructor-source-matrix > .hint {
      margin: 0; font-size: .875rem; line-height: 1.6;
    }
    .instructor-source-matrix-grid {
      display: grid; gap: .75rem; min-width: 0;
    }
    .source-matrix-item {
      display: grid; gap: .45rem; min-width: 0; padding: .75rem;
      border: 1px solid #355364; border-radius: 6px;
      background: #0c202d; overflow-wrap: anywhere;
    }
    .source-matrix-item h4 {
      margin: 0; color: var(--source-matrix-title);
      font-size: .875rem; line-height: 1.5; font-weight: 750;
    }
    .source-matrix-state {
      color: var(--source-matrix-accent);
      font: 650 .8125rem/1.55 "Segoe UI", system-ui, sans-serif;
      overflow-wrap: anywhere;
    }
    .source-matrix-item p {
      margin: 0; font-size: .875rem; line-height: 1.6;
    }
    .source-matrix-item .source-matrix-details {
      color: var(--source-matrix-detail);
      font-size: .8125rem; line-height: 1.6;
      overflow-wrap: anywhere;
    }
    .controls { position: absolute; left: 71.5%; width: 23%; top: 6.5%; bottom: 7%; min-width: 0; font-family: var(--panel-font); }
    .hardware-key { min-height: 31px; border: 1px solid #797f82; border-bottom: 3px solid #20272c; border-radius: 9px; background: linear-gradient(var(--key-top),var(--key-bottom)); color: var(--panel-ink); text-shadow: 0 1px #18232c; font: 700 11px var(--panel-font); letter-spacing: .5px; box-shadow: inset 0 1px #8a9296, 0 2px 4px #182128; }
    .hardware-key span { font-size: 9px; font-weight: 400; }
    .hardware-key:active { border-bottom-width: 2px; }
    .controls > #key-menu { position: absolute; top: 0; left: 21%; width: 58%; height: 34px; line-height: 1.1; border-radius: 48% 48% 16% 16%; }
    .key-row { position: absolute; top: 33%; left: 20%; width: 60%; display: grid; grid-template-columns: 1fr; gap: 8px; }
    .pad { position: absolute; top: 7%; left: 50%; transform: translateX(-50%); height: 96px; width: 96px; border-radius: 50%; border: 3px solid #232a2f; background: radial-gradient(circle at 35% 25%,#60676b,#3c444a 65%,#2d353b); box-shadow: inset 0 2px 3px #85909780, inset 0 -4px 5px #172027, 0 1px #727d82; }
    .pad::after { content: ""; position: absolute; left: 50%; top: 50%; width: 22px; height: 22px; transform: translate(-50%,-50%); border-radius: 50%; background: radial-gradient(circle at 35% 28%,#596168,#363e44); pointer-events: none; }
    .pad button { position: absolute; border: 0; background: transparent; color: var(--panel-ink); font-size: 15px; padding: 0; }
    .pad button.pressing { background: #25333c; }
    .pad .pad-up { width: 32px; height: 26px; top: 0; left: 29px; border-radius: 40% 40% 10% 10%; }
    .pad .pad-down { width: 32px; height: 26px; bottom: 0; left: 29px; border-radius: 10% 10% 40% 40%; }
    .pad .pad-left { width: 26px; height: 32px; left: 0; top: 29px; border-radius: 40% 10% 10% 40%; }
    .pad .pad-right { width: 26px; height: 32px; right: 0; top: 29px; border-radius: 10% 40% 40% 10%; }
    .enter-key { position: absolute; top: 25%; left: 21%; width: 58%; border-radius: 16% 16% 48% 48%; }
    .knob-wrap { position: absolute; width: 100%; display: flex; flex-direction: column; align-items: center; gap: 4px; }
    .gain-wrap { top: 54%; }
    .mode-wrap { top: 73%; }
    .knob-label { color: #f0f5f7; font-size: 12px; font-weight: 800; letter-spacing: 1px; }
    .knob-label small { display: block; font-size: 8px; font-weight: 500; color: #bfced5; letter-spacing: .3px; text-align: center; }
    .knob-group { position: relative; display: flex; align-items: center; justify-content: center; }
    .knob { position: relative; width: 65px; height: 65px; border-radius: 50%; display: grid; place-content: center; border: 4px solid #aeb5b8; background: repeating-conic-gradient(#363d42 0deg 8deg, #646d72 8deg 12deg); box-shadow: inset 0 0 0 8px #3b4349, inset 0 0 0 23px #2a3239, 0 3px 7px #152129; color: var(--panel-ink); touch-action: none; padding: 0; }
    .knob::before { content: ""; position: absolute; inset: 3px; border-radius: 50%; transform: rotate(var(--dial-angle, 0deg)); background: linear-gradient(#f1f3f2,#d2d8d8) center top / 3px 11px no-repeat; pointer-events: none; }
    .knob-mode { outline: 1px solid #1b252a; }
    .knob:active { transform: scale(.98); }
    .mode-scale { position: absolute; inset: 0; pointer-events: none; color: #d6dcdf; font-size: 7px; line-height: 1; font-weight: 650; }
    .mode-scale span { position: absolute; white-space: nowrap; }
    .mode-scale [data-mode="NAV1"] { right: 100%; bottom: 3px; margin-right: 5px; }
    .mode-scale [data-mode="LF-ZOOM"] { right: 100%; top: 26px; margin-right: 5px; }
    .mode-scale [data-mode="LF"] { right: 100%; top: 3px; margin-right: 5px; }
    .mode-scale [data-mode="DUAL"] { left: 50%; top: -11px; transform: translateX(-50%); }
    .mode-scale [data-mode="HF"] { left: 100%; top: 3px; margin-left: 5px; }
    .mode-scale [data-mode="HF-ZOOM"] { left: 100%; top: 26px; margin-left: 5px; }
    .mode-scale [data-mode="NAV2"] { left: 100%; bottom: 3px; margin-left: 5px; }
    .mode-scale [data-selected="true"] { color: #ffffff; text-decoration: underline; text-underline-offset: 2px; }
    .mode-wrap .knob-label { margin-bottom: 9px; }
    .detent { width: 24px; height: 30px; border: 1px solid #a1adb3; background: #44535e; border-radius: 5px; font-size: 19px; }
    .rotary-assist { padding: 10px; border: 1px solid #375366; background: #102735; border-radius: 10px; }
    .rotary-assist h3 { margin: 3px 0 5px; }
    .rotary-assist .hint { margin: 0 0 10px; font-size: 11px; }
    .rotary-assist-row { display: grid; grid-template-columns: 1fr 48px 48px; align-items: center; gap: 9px; padding: 6px 3px; font-size: 12px; font-weight: 750; }
    .trainer-rotate { min-height: 34px; border: 1px solid #7195a2; border-radius: 6px; background: #243e4d; color: #d9f3fa; font-weight: 750; font-size: 19px; }
    .power-button { position: absolute; top: 93%; left: calc(50% - 20px); width: 40px; height: 37px; border-radius: 44%; border: 1px solid #83a9bf; background: linear-gradient(#588cb0,#246189); box-shadow: inset 0 1px #a3becd, 0 3px 4px #1a2730; font-weight: 800; padding: 0; }
    .power-button span { position: absolute; left: calc(100% + 8px); top: 11px; letter-spacing: .5px; font: 700 10px var(--panel-font); }
    .power-glyph { position: relative; display: block; width: 17px; height: 17px; margin: auto; border: 2px solid #e5eef1; border-top-color: transparent; border-radius: 50%; }
    .power-glyph::before { content: ""; position: absolute; width: 2px; height: 9px; left: 5.5px; top: -3px; background: #e5eef1; }
    .power-button.pressing { background: linear-gradient(#96bbd9, #2c7bb4); }
    .device-footer { position: static; color: #a9bac3; font-size: 10px; letter-spacing: .2px; line-height: 1.5; }
    .operator-quick-guide { display: none; }
    .operator-quick-guide[hidden] { display: none !important; }
    .mobile-training-note { display: none; }
    .training-panel { border: 1px solid #2c4451; background: linear-gradient(#102331, #0e1d29); border-radius: 16px; padding: 23px; box-shadow: 0 15px 30px #05101955; }
    .panel-head h2 { margin: 2px 0 18px; font-size: 22px; }
    .stats { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 7px; }
    .stats div { background: #0b1722; border: 1px solid #294355; padding: 11px 7px; border-radius: 8px; text-align: center; }
    .stats small { display: block; color: #7693a3; letter-spacing: 1px; font-size: 9px; }
    .stats strong { display: block; margin-top: 5px; font: 700 20px Consolas, monospace; color: #e6f4fb; }
    .trainer-buttons { display: grid; gap: 8px; margin: 17px 0; }
    .trainer-buttons button { border: 1px solid #406273; padding: 11px; border-radius: 7px; background: #172d3c; color: #d6e8f2; font-size: 13px; }
    .trainer-buttons button.primary { background: #0e6479; border-color: #2696a6; color: #fff; font-weight: 700; }
    .validation-status { padding: 12px; border-radius: 8px; border: 1px solid #405562; background: #102531; font-size: 11px; line-height: 1.6; color: #9fc1d0; min-height: 61px; }
    .lesson-panel { border: 1px solid #365b67; background: #132a39; border-radius: 9px; padding: 12px; display: grid; grid-template-columns: minmax(0, 1fr); min-width: 0; gap: 8px; }
    .lesson-panel > * { min-width: 0; }
    .lesson-panel label { color: #d5e5f0; font-size: 12px; font-weight: 650; }
    .lesson-panel select, .lesson-panel button { min-height: 38px; width: 100%; max-width: 100%; border: 1px solid #507485; border-radius: 6px; color: #eef8ff; background: #173d53; padding: 8px; font: 600 12px system-ui,sans-serif; }
    .lesson-panel button { background: #126579; cursor: pointer; }
    .lesson-panel #lesson-result { color: #a8d9e7; font-size: 12px; line-height: 1.5; }
    .training-panel h3 { font-size: 12px; color: #9dcbd3; text-transform: uppercase; letter-spacing: 1.1px; margin: 24px 0 8px; }
    .hint { font-size: 12px; line-height: 1.6; color: #b3c4cf; }
    .shortcut-line { color: #92a9b9; font-size: 11px; line-height: 2.5; }
    kbd { background: #243d4c; border: 1px solid #507182; padding: 3px 5px; border-radius: 3px; font-family: Consolas, monospace; }
    .device-roadmap { display: grid; gap: 3px; }
    .device-roadmap div { display: flex; flex-wrap: wrap; gap: 7px; font-size: 11px; color: #628494; padding: 8px 0; border-bottom: 1px solid #254050; }
    .device-roadmap strong { color: #bdd7e3; }
    .device-roadmap em { font-style: normal; margin-left: auto; color: #829fac; font-size: 10px; }
    .disclaimer { padding: 12px 0 0; font-size: 11px; color: #91aab6; text-align: center; line-height: 1.6; }
    @media (max-width: 1240px) {
      .workbench { grid-template-columns: minmax(0, 1fr); }
      .device-frame { width: 100%; margin: auto; }
      .training-panel { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 22px; }
      .training-panel > .panel-head, .training-panel > .stats,
      .training-panel > .trainer-buttons, .training-panel > .validation-status,
      .training-panel > .rotary-assist { grid-column: span 1; }
      .training-panel > .operator-guidance, .training-panel > .device-footer,
      .training-panel > .mobile-training-note,
      .training-panel > .instructor-source-matrix { grid-column: span 2; }
      .training-panel > .instructor-telemetry { grid-column: span 2; }
      /* Direct children only: targeting every nested h3 created a phantom second
         CSS Grid column inside D15 lesson forms, squeezing action buttons. */
      .training-panel > h3, .training-panel > .device-roadmap { grid-column: span 2; }
      .trainer-buttons { margin: 0; }
    }
    @media (max-width: 700px) {
      .app { padding: 0 9px 24px; }
      .workbench > .mobile-training-note { grid-column: 1 / -1; display: block;
        margin: 0; padding: 9px 11px; border: 1px solid #49616d;
        border-radius: 6px; color: #c7e0e7; background: #132a37;
        font-size: 10px; line-height: 1.5; }
      .workbench > .operator-quick-guide:not([hidden]) { grid-column: 1 / -1;
        display: grid; gap: 3px; position: static; z-index: auto;
        border: 1px solid #78b8ca; border-radius: 6px; padding: 6px 9px;
        background: #0c2938; color: #ecf8fa; box-shadow: none;
        font-size: 11px; line-height: 1.3; }
      .operator-quick-guide strong { font-size: 10px; letter-spacing: .4px; }
      .operator-quick-guide span { white-space: normal; overflow-wrap: anywhere; }
      .masthead { min-height: 70px; }
      .state-chip { display: none; }
      .heading { margin: 22px 9px; display: block; }
      .live-chip { display: inline-block; margin-top: 7px; }
      /* Phone: a deliberately RE-FLOWED training face, not the OEM bezel map.
         Preserve the entire portrait LCD and enlarged physical-input hit areas;
         never imply that this stacked view matches the hardware geometry. */
      .device-frame { aspect-ratio: auto; border: 3px solid #293136; padding: 10px 8px; border-radius: 12px; background: #343d43; }
      .device-frame::before, .device-frame::after { display: none; }
      .bezel-header { padding: 0 2px 4px; }
      .equipment { display: grid; grid-template-columns: minmax(0, 1fr); aspect-ratio: auto; gap: 12px; padding-inline: 0; border: 0; border-radius: 0; background: none; box-shadow: none; }
      .display-housing { position: relative; left: auto; top: auto; width: 100%; padding: 4px; border-width: 1px; }
      .instructor-telemetry { font-size: 11px; }
      .controls { position: static; width: auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
        justify-content: stretch; align-items: center; gap: 16px 12px; padding: 8px 4px; }
      .hardware-key { min-height: 44px; font-size: 12px; }
      .controls > #key-menu, .controls > #key-func,
      .controls > #key-enter, .controls > .key-row,
      .controls > .pad, .controls > #key-power { grid-column: 1 / -1; }
      .controls > #key-menu, .enter-key, .key-row, .knob-wrap, .power-button { position: static; width: 100%; }
      .controls > #key-menu { height: 48px; border-radius: 8px; }
      .pad { width: 160px; height: 160px; margin: 0 auto; position: relative; left: auto; top: auto; transform: none; }
      .pad::after { width: 32px; height: 32px; }
      .pad .pad-up { width: 44px; height: 44px; left: 55px; top: 3px; font-size: 17px; }
      .pad .pad-down { width: 44px; height: 44px; left: 55px; bottom: 3px; font-size: 17px; }
      .pad .pad-left { width: 44px; height: 44px; left: 3px; top: 55px; font-size: 17px; }
      .pad .pad-right { width: 44px; height: 44px; right: 3px; top: 55px; font-size: 17px; }
      .enter-key { width: 100%; margin-top: 0; border-radius: 8px; }
      .key-row { gap: 12px; grid-template-columns: 1fr; }
      .knob-label { font-size: 10px; }
      .knob-label small { display: none; }
      .knob { width: 64px; height: 64px; border-width: 5px; font-size: 11px; }
      .mode-scale { display: none; }
      .mode-wrap .knob-label { margin-bottom: 0; }
      .power-button { width: 100%; max-width: 250px; height: 50px; font-size: 12px; border-radius: 9px; margin: auto; display: flex; align-items: center; justify-content: center; gap: 10px; }
      .power-glyph { margin: 0; }
      .power-button span { position: static; font-size: 11px; }
      .device-footer { position: static; font-size: 9px; margin-top: 12px; }
      .mobile-training-note { display: block; font-size: 10px; line-height: 1.5;
        color: #c9dfe7; text-align: center; margin: 7px 0 0; }
      .lcd-overlay { width: 83%; left: 9%; top: 12%; max-height: 84%; min-width: 0; font-size: 11px; }
      .lcd-overlay-content { padding: 8px; line-height: 1.5; }
      .lcd-overlay-title { padding: 5px; }
      .lcd-overlay-footer { display: none; }
      .lcd-overlay[data-layout="main-menu"] .lcd-overlay-footer,
      .lcd-overlay[data-layout="func-setting"] .lcd-overlay-footer { display: block; }
      .lcd-menu-categories { font-size: 10px; }
      .lcd-menu-options { max-height: 105px; }
      .training-panel { display: block; padding: 14px; }
      .trainer-rotate { min-height: 44px; min-width: 44px; }
      .trainer-buttons button { min-height: 44px; }
      .lesson-panel select, .lesson-panel button { width: 100%; min-height: 44px; }
      .trainer-buttons { margin: 13px 0; }
      .depth-indicator strong { font-size: 25px; letter-spacing: -1px; }
      .depth-indicator span { font-size: 10px; }
    }
    
    /* V56: Only the off-device instructor D15 switches between compact tabs.
       The OEM-lookalike .device-frame/.lcd and original control geometry remain
       untouched. Without JS, .d15-enhanced is absent and all sections stay open. */
    .d15-tablist[hidden], .d15-tabpanel[hidden] { display: none !important; }
    .d15-tablist { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 6px; padding: 3px; }
    .d15-tab { min-width: 0; min-height: 44px; padding: 6px 5px; border-radius: 7px;
      border: 1px solid #4b7585; color: #dbeaf0; background: #152d3a;
      font: 700 11px/1.25 "Segoe UI", Arial, sans-serif; text-align: center; }
    .d15-tab:nth-child(5) { grid-column: span 2; }
    .d15-tab[aria-selected="true"] { background: #126477; color: #fff;
      border-color: #80ccd9; box-shadow: inset 0 -3px 0 #9be1e6; }
    .d15-tab:focus-visible { outline: 3px solid #ffc564; outline-offset: 1px; }
    .training-panel.d15-enhanced { position: sticky; top: 12px;
      display: flex; flex-direction: column; gap: 8px; min-height: 0;
      height: min(780px, calc(100dvh - 24px)); max-height: calc(100dvh - 24px);
      padding: 13px; overflow: hidden; }
    .d15-enhanced .panel-head h2 { font-size: 18px; margin: 0; line-height: 1.25; }
    .d15-enhanced .device-footer { margin: 0; font-size: 10px; line-height: 1.3; }
    .d15-enhanced .d15-tabpanels { flex: 1 1 auto; min-height: 0; overflow: hidden; }
    .d15-enhanced .d15-tabpanel { height: 100%; min-height: 0;
